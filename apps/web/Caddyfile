# Serves the client and proxies the API on one origin, with automatic HTTPS
# for $DOMAIN. /metrics is deliberately not routed: Prometheus scrapes the
# server over the internal network.
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "frame-ancestors 'none'"
	}

	@api path /auth/* /boards /boards/* /ws /healthz /readyz
	handle @api {
		reverse_proxy {$UPSTREAM:server:8080}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
