{
  "name": "@tandem/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "bench": "node build.mjs && tsx bench/load.ts",
    "chaos": "tsx bench/chaos.ts",
    "coldload": "node build.mjs && tsx bench/coldload.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@tandem/crdt": "workspace:*",
    "@tandem/protocol": "workspace:*",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "redis": "^6.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15"
  }
}
